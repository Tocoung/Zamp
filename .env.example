# ==============================================================================
# Global Configuration Example - Zamp Vendor Onboarding Automation
# ==============================================================================
# Copy this file to .env or configure respective frontend/backend .env files.
# NEVER commit credentials or active secrets to version control.

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration
# Default: Local SQLite database (predictable path resolution against project root)
# Production (requires driver e.g. psycopg2-binary): postgresql+psycopg2://user:password@localhost:5432/zamp_onboarding
DATABASE_URL=sqlite:///./vendor_onboarding.db

# Security & Data Encryption (Fernet 32-byte URL-safe base64 key)
# Generate a local key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit a real encryption key. Replace the placeholder below in your active .env file.
VENDOR_DATA_ENCRYPTION_KEY=replace-with-your-generated-fernet-key-32bytes-base64=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
